# Telegram MTProto
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# AI summaries
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=your_gemini_model_here
GEMINI_FALLBACK_MODELS=your_fallback_models_here

# Telegram production notification bot and channel
TG_BOT_TOKEN_PROD=your_tg_bot_token_prod_here
TG_NOTIFICATION_CHANNEL=@botapinews

# Common data repository
DATA_REPOSITORY_URL=https://github.com/your-user/your-data-repository.git
DATA_REPOSITORY_BRANCH=main
DATA_REPOSITORY_DIR=data-repository

# Detection environments: both production and Telegram Test Server
RESOURCE_WATCHER_ENVIRONMENTS=prod,test

# One-shot mode for GitHub Actions
RESOURCE_WATCHER_RUN_ONCE=1
